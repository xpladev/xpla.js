{
  "name": "@xpla/xpla.js",
  "version": "1.14.1",
  "description": "The JavaScript SDK for Xpla",
  "license": "MIT",
  "author": "XPLA",
  "keywords": [
    "xpla",
    "cryptocurrency",
    "blockchain",
    "smart-contracts",
    "wasm",
    "altcoin",
    "altcoins",
    "wallet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpladev/xpla.js.git"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run clean && npm run build:modules && webpack --mode production",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "doc": "typedoc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "analyze": "webpack --mode production --env analyze",
    "build:modules": "tsc && tsc -p tsconfig.esm.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/readable-stream": "^4.0.25",
    "@types/tmp": "^0.2.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "ts-loader": "^9.6.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "webpack": "^5.112.0",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@xpla/xpla.proto": "^1.14.0",
    "@xpla/xpla.proto-v1_8": "npm:@xpla/xpla.proto@1.8.0",
    "axios": "^1.20.0",
    "bech32": "^2.0.0",
    "decimal.js": "^10.6.0",
    "readable-stream": "^4.8.0",
    "rlp": "^3.0.0",
    "tmp": "^0.2.7",
    "ws": "^8.22.0"
  },
  "module": "dist/esm/index.js",
  "sideEffects": [
    "./src/index.ts",
    "./src/core/index.ts",
    "./src/core/numeric.ts",
    "./dist/index.js",
    "./dist/core/index.js",
    "./dist/core/numeric.js",
    "./dist/esm/index.js",
    "./dist/esm/core/index.js",
    "./dist/esm/core/numeric.js",
    "./dist/bundle.js",
    "./dist/bundle.node.js"
  ]
}
